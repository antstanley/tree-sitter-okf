}

GROUPS = ["Document", "Frontmatter", "Blocks", "Inlines"]

HEADER = """# Node types

<!-- Generated by script/node-types from src/node-types.json.  Do not edit:
     edit the table in script/node-types and run it.  CI runs it with --check. -->

The public API of the grammar: every named node, its fields, and where its
name comes from.  Node and field names are API (spec P7): within one OKF
version (one MAJOR.MINOR, see docs/releasing.md) they are only added, never
renamed or removed.

Names are reused from [tree-sitter-markdown] and [tree-sitter-yaml] wherever a
construct corresponds (spec D10), so queries written for those grammars mostly
work here; **Divergence** records every place they do not.  `okf-new` marks a
node neither grammar has.

Hidden rules (`_name`) and anonymous tokens (`"-"`, `"["`, ...) are not
listed.  Differences from the node names sketched in docs/grammar-spec.md
§6: the heading text is the `heading_content` *field* on an `inline` node
(upstream's shape), and there are no `text`, `soft_line_break` or
`html_comment` nodes (upstream has none; the text is in its parent's range).

[tree-sitter-markdown]: https://github.com/tree-sitter-grammars/tree-sitter-markdown
[tree-sitter-yaml]: https://github.com/tree-sitter-grammars/tree-sitter-yaml
"""


def describe_types(types):
    return ", ".join(f"`{t['type']}`" if t["named"] else f"`\"{t['type']}\"`" for t in types)


def render(node_types):
    by_type = {n["type"]: n for n in node_types if n["named"]}
    out = [HEADER]
    for group in GROUPS:
        out.append(f"\n## {group}\n")
        for name, (g, source, divergence, description) in NODES.items():
            if g != group or name not in by_type:
                continue
            n = by_type[name]
            out.append(f"\n### `{name}`\n\n{description}\n")
            meta = [f"- **Source:** {source}"]
            if divergence:
                meta.append(f"- **Divergence:** {divergence}")
            for field, spec in sorted((n.get("fields") or {}).items()):
                flags = []
                if spec.get("required"):
                    flags.append("required")
                if spec.get("multiple"):
                    flags.append("multiple")
                meta.append(f"- **Field `{field}`** ({', '.join(flags) or 'optional'}): "
                            f"{describe_types(spec['types'])}")
            children = n.get("children")
            if children:
                meta.append(f"- **Children:** {describe_types(children['types'])}")
            out.append("\n".join(meta) + "\n")
    return "".join(out)


def main():
    check = "--check" in sys.argv
    node_types = json.load(open(NODE_TYPES, encoding="utf-8"))
    named = {n["type"] for n in node_types if n["named"]}
    missing = sorted(named - set(NODES))
    stale = sorted(set(NODES) - named)
    problems = []
    if missing:
        problems.append("nodes with no row in script/node-types: " + ", ".join(missing))
    if stale:
        problems.append("rows for nodes the grammar no longer has: " + ", ".join(stale))
    text = render(node_types)
    if check:
        current = open(OUTPUT, encoding="utf-8").read() if os.path.exists(OUTPUT) else ""
        if current != text:
            problems.append("docs/node-types.md is out of date: run script/node-types")
    else:
        with open(OUTPUT, "w", encoding="utf-8") as f:
            f.write(text)
        print(f"wrote {os.path.relpath(OUTPUT, ROOT)} ({len(named)} nodes)")
    for p in problems:
        print(p)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
