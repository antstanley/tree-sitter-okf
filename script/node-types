#!/usr/bin/env python3
"""Generate docs/node-types.md from src/node-types.json (spec §7.2, §7.6).

Every public (named) node gets a row: its fields and children, where its name
comes from (tree-sitter-markdown, tree-sitter-yaml, or new in OKF) and how it
diverges from that source.  `--check` fails if a node has no row here, or if
docs/node-types.md is out of date, so the alignment table cannot drift from
the grammar (`make check-nodes` / CI).

Usage: script/node-types [--check]
"""

import json
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
NODE_TYPES = os.path.join(ROOT, "src", "node-types.json")
OUTPUT = os.path.join(ROOT, "docs", "node-types.md")

MD = "tree-sitter-markdown"
