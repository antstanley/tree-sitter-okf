#!/usr/bin/env bash
# Apply pending changesets (spec §10.3).  `changeset version` bumps
# package.json and writes CHANGELOG.md; `tree-sitter version` then carries
# the new version into every other manifest and lockfile (Cargo.toml,
# Cargo.lock, pyproject.toml, tree-sitter.json, Makefile, CMakeLists.txt,
# package-lock.json), so the tag check in release.yml always agrees.
#
# Run by the "Version packages" PR (.github/workflows/version-pr.yml).
# @changesets/changelog-github needs GITHUB_TOKEN to look up PR links.
set -euo pipefail
cd "$(dirname "$0")/.."

npx changeset version
version=$(node -p "require('./package.json').version")
# `tree-sitter version` updates Cargo.lock with an offline cargo, which
# needs the dependencies in the local registry cache (a fresh CI runner has
# none)
if command -v cargo >/dev/null 2>&1; then cargo fetch --quiet; fi
npx tree-sitter version "$version"
# MAJOR.MINOR must still be the OKF version: a `minor` or `major` changeset
# is only right when okfVersion in package.json moved too
node script/check-versions.js
echo "versioned packages at $version"
