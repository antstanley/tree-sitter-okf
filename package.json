{
  "name": "tree-sitter-okf",
  "version": "1.0.0",
  "description": "Open Knowledge Format (OKF) grammar for tree-sitter",
  "repository": "https://github.com/antstanley/tree-sitter-okf",
  "license": "MIT",
  "keywords": [
    "tree-sitter",
    "parser",
    "lexer",
    "okf",
    "open-knowledge-format",
    "markdown",
    "frontmatter"
  ],
  "main": "bindings/node",
  "types": "bindings/node/index.d.ts",
  "files": [
    "grammar.js",
    "grammar/",
    "queries/",
    "src/grammar.json",
    "src/node-types.json",
    "src/parser.c",
    "src/scanner.c",
    "src/tree_sitter/",
    "bindings/node/",
    "!bindings/node/*_test.js",
    "bindings/c/tree_sitter/tree-sitter-okf.h",
    "binding.gyp",
    "prebuilds/**",
    "tree-sitter.json",
    "LICENSE",
    "NOTICE"
  ],
  "tree-sitter": [
    {
      "scope": "source.okf",
      "file-types": [
        "md",
        "markdown"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm",
      "tags": "queries/tags.scm"
    }
  ],
  "scripts": {
    "generate": "tree-sitter generate --abi 14",
    "build": "tree-sitter build",
    "test": "tree-sitter test",
    "test:all": "script/test",
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test:bindings": "node --test bindings/node/*_test.js"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "node-gyp-build": "^4.8.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.25.10"
  }
}
